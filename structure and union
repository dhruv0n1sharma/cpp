------union-------

#include <iostream>
using namespace std;

union Data {
    int x;
    char y;
};

int main() {
    Data d;

    cout << "--- Union Output ---" << endl;
    
    // Writing to x overwrites the shared memory space
    d.x = 65; 
    cout << "Value of x: " << d.x << endl;
    
    // Accessing y reads the exact same memory space as character
    cout << "Value of y: " << d.y << endl; 

    return 0;
}

